# Development defaults (mock mode needs no API key)
APP_ENV=development
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
ALLOWED_HOSTS=localhost,127.0.0.1,test
# Uvicorn proxy trust: local default; use verified ingress IPs/CIDRs on Render.
FORWARDED_ALLOW_IPS=127.0.0.1

# Bounded resource controls
SESSION_TTL_MINUTES=60
MAX_ACTIVE_SESSIONS=500
MAX_PROMPT_LENGTH=2000
MAX_REQUEST_BODY_BYTES=16384
CHAT_REQUESTS_PER_MINUTE=20
AUTOMATION_RUNS_PER_MINUTE=3
MAX_CONCURRENT_LLM_REQUESTS=8
LLM_QUEUE_TIMEOUT_SECONDS=5
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=45
MAX_LLM_RESPONSE_BYTES=65536
AUTOMATION_RUN_TIMEOUT_SECONDS=180

# Local Ollama development override:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2:7b

# Production example. Store LLM_API_KEY in the hosting platform's secret store.
# APP_ENV=production
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-private-inference-host.example/v1
# LLM_API_KEY=replace-via-platform-secret
# LLM_MODEL=your-hosted-model
# ALLOWED_HOSTS=play.failedtraining.com,your-service-hostname.example
