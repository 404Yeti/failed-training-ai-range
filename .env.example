LLM_PROVIDER=mock

# Ollama on the Docker host (uncomment all four lines):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2:7b

# Any other OpenAI-compatible server can use the same variables. The base URL
# must end immediately before /chat/completions.
# MAX_PROMPT_LENGTH=2000
